<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
 <display-name>LMS</display-name>
 <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
 </welcome-file-list>
  <servlet>
 	<servlet-name>HelloWorldServlet</servlet-name>
 	<servlet-class>com.training.servlet.HelloWorldServlet</servlet-class>
 </servlet>
 <servlet-mapping>
 	<servlet-name>HelloWorldServlet</servlet-name>
 	<url-pattern>/HelloWorldServlet</url-pattern>
 </servlet-mapping>
  <servlet>
 	<servlet-name>LoginServlet</servlet-name>
 	<servlet-class>com.training.servlet.LoginServlet</servlet-class>
 </servlet>
 <servlet-mapping>
 	<servlet-name>LoginServlet</servlet-name>
 	<url-pattern>/login</url-pattern>
 </servlet-mapping>
 <servlet>
 	<servlet-name>UserServlet</servlet-name>
 	<servlet-class>com.training.servlet.UserServlet</servlet-class>
 </servlet>
 <servlet-mapping>
 	<servlet-name>UserServlet</servlet-name>
 	<url-pattern>/users</url-pattern>
 </servlet-mapping>
</web-app>
